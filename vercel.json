{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/astronauts.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/astronauts",
      "destination": "/api/astronauts.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
